---
import { Image } from 'astro:assets';
import clock from '../assets/clock.png';
import now from '../assets/icons8-time.gif';
import checkmark from '../assets/checkmark.png';

interface Props {
  start: string;
  end?: string;
  name: string;
  title?: string;
  first: boolean;
  last: boolean;
  past: boolean;
  next: boolean;
}

const {start, end, name, title, first, last, prev, next} = Astro.props;

const endTime = end ? " — " + end : ""
const past = prev && next
const future = !prev && !next

---

<li>
  {!first && (prev ? <hr class="bg-primary"/> : <hr/>) }
  <div class="timeline-start max-w-40"><time class="font-mono italic">{start}{endTime}</time></div>
  <div class="timeline-middle">
    {past ? <Image src={checkmark} alt="checkmark" /> :
    (!future ? <Image src={now}   width="24" alt="happening now" /> :
               <Image src={clock} alt="clock" />)}
  </div>
  <div class="timeline-end min-w-48">
  <div class="text-lg font-black">{name}</div>
  {title}
  </div>
  {!last && (next ? <hr class="bg-primary"/> : <hr/>)}
</li>
