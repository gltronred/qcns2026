---
import Layout from '../layouts/Layout.astro';

import ScheduleItem from '../components/ScheduleItem.astro';
import Schedule from '../components/Schedule.astro';

const config = {
  "now": "12:00",
  "schedule": [
	{"start":"10:00", "end":"11:00",
     "name":"Николаев М.С.",
     "title": "Жадная гипотеза в задаче о кратчайшей общей надстроке и ее обобщения"},
	{"start":"11:00", "end":"11:20", "name":"Coffee Break"},
	{"start":"11:20", "end":"12:20",
     "name":"Кулагин А.В., Ожигов Ю.И.",
     "title":"Темные состояния и квантовые эффекты в контексте исследования конечномерных моделей"},
	{"start":"12:20", "end":"12:40",
     "name":"Салихова Н.М., Аблаев Ф.М.",
     "title":"Квантовые алгоритмы поиска подстроки в строке на основе хеширования"},
	{"start":"12:40", "end":"13:40",
     "name":"Аблаев Ф.М.",
     "title":"Квантовое хеширование: передача информации, алгоритмы"},
  ]
}
---

<Layout title="Schedule">

<h1 class="text-4xl pb-2">Schedule</h1>

<h2 class="text-3xl pb-2">Saturday, June 28</h2>
<div class="items-left">
  <Schedule config={config} />
</div>

</Layout>
