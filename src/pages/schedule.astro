---
import Layout from '../layouts/Layout.astro';

import ScheduleItem from '../components/ScheduleItem.astro';
import Schedule from '../components/Schedule.astro';

import coffee from '../assets/icons8-coffee-64.png'

const config = {
  "now": "12:00",
  "schedule": [
    {"start":"10:00", "end":"10:15",
     "title":"Lorenzo Mazzei, Giada Beccari, Mirko Laruina and Marco Cococcioni (University of Pisa, Italy)",
     "name":"Solving Currency Arbitrage Problems using D-Wave Advantage2 Quantum Annealer"},
    {"start":"10:20", "end":"10:35",
     "title":"Vincenzo Spadari and Alfredo Nascita (University of Napoli Federico II, Italy); Idio Guarino (University of Bologna, Italy); Domenico Ciuonzo (University of Naples Federico II, Italy); Antonio Pescapé (University of Napoli Federico II, Italy)",
     "name":"Explainable Quantum Machine Learning for IoMT Security: Evaluating Quantum Advantage"},
    {"start":"10:40", "end":"10:55",
     "title":"Alessia Ciacco (University of Calabria, Italy); Luigi Di Puglia Pugliese (ICAR - CNR, Italy); Francesca Guerriero (University of Calabria, Italy)",
     "name":"Traveling Salesman Problem with a preprocessing method for classical and quantum optimization"},

    {"start":"11:00", "end":"11:30", "name":"Coffee break", "icon": coffee, "alticon": "Coffee cup"},

    {"start":"11:30", "end":"11:45",
     "title":"Patrick Hamilton, M Arif Khan and Rafiqul Islam (Charles Sturt University, Australia); Fendy Santoso (AI and Cyber Futures Institute, Charles Sturt University, Australia)",
     "name":"QAIRAS: A Resource-Bounded Hybrid Quantum-Inspired Architecture for Secure Smart Systems"},
    {"start":"11:50", "end":"12:05",
     "title":"Radhakrishnan Delhibabu (VIT Vellore, India); Manuel Mazzara (Innopolis University, Russia); Salvatore Distefano (University of Kazan, Italy)",
     "name":"Federated Variational Quantum Neural Networks for Privacy-Preserving Anomaly Detection in Smart IoT Networks"},
    {"start":"12:10", "end":"12:25",
     "title":"Franco Cirillo, Maria Caterina D'Aloia and Christian Esposito (University of Salerno, Italy)",
     "name":"Integrating Classical and Quantum PUF with QKD for Secure IoT Networks"},

    {"start":"12:30", "end":"13:00", "name":"Coffee break", "icon": coffee, "alticon": "Coffee cup"},

    {"start":"13:00", "end":"13:15",
     "title":"Mansur Ziiatdinov (University of Messina, Italy); Salvatore Distefano (University of Kazan, Italy)",
     "name":"A Recipe for Data-driven Medicine: Data Encoding, Machine Learning, and Quantum Computing"},
    {"start":"13:20", "end":"13:35",
     "title":"Kamil Khadiev and Aliia Khadieva (Kazan Federal University, Russia)",
     "name":"Quantum k-means based on Quantum Local Sensitive Hashing with Application to Irrigation Machine Sensors Data Clustering"},
    {"start":"13:40", "end":"13:55",
     "title":"Farida Farsian (INAF-Osservatorio astrofisico di Catania); Attilio Azzarelli and Fabrizio De Vita (University of Messina, Italy); Giovanni Merlino (University of Messina &amp; National Interuniversity Consortium for Informatics (CINI), Italy); Francesco Schilliro (INAF-Ossetvatorio Astrofisico di Catania, Italy)",
     "name":"Assessing the Feasibility of Quantum Autoencoders for Real-World Visual Anomaly Detection"},

    {"start":"14:00", "end":"15:00", "name":"Lunch"},

    {"start":"15:00", "end":"15:15",
     "title":"Marcello Caleffi, Laura d'Avossa, Italo Ignacio Machuca Flores, Marco Grillo, Elena Montella and Angela Sara Cacciapuoti (University of Naples Federico II, Italy)",
     "name":"Towards Quantum Networks: Characterizing Raman Noise over Metropolitan scale Fiber Network"},
    {"start":"15:20", "end":"15:35",
     "title":"Francesco Mazza, Adam Pearson, Marcello Caleffi and Angela Sara Cacciapuoti (University of Naples Federico II, Italy)",
     "name":"Q2NS Demo: A Quantum Network Simulator Based on ns-3"}
  ]
}
---

<Layout title="Schedule">

<h1 class="text-4xl pb-2">Schedule</h1>

<h2 class="text-3xl pb-2">Monday, June 22</h2>
<div class="items-left">
  <Schedule config={config} />
</div>

</Layout>
